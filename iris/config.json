{
  "owner": "theforeveriris",
  "repo": "md-preview",
  "branch": "main",
  "provider": "github",
  "title": "Markdown Preview",
  "defaultTheme": "default",
  "showEditButton": true,
  "showReadingTime": true,
  "showBreadcrumbs": true,

  "_pinned_params_doc": {
    "_说明": "↑ 以上顶层键均可在 config.json 中固定为指定值，覆盖代码内置默认值。修改后推送代码即生效，无需改代码。下方为各键详细说明。",
    "owner": { "type": "string", "description": "GitHub/Gitee/GitLab 用户名或组织名" },
    "repo": { "type": "string", "description": "仓库名" },
    "branch": { "type": "string", "default": "main", "description": "文档所在的 Git 分支（影响文件树回退与 git 历史）" },
    "provider": { "type": "string", "default": "github", "description": "Git 托管平台：github | gitee | gitlab" },
    "gitlabUrl": { "type": "string", "default": "https://gitlab.com", "description": "自托管 GitLab 地址（仅 provider=gitlab 时生效）" },
    "projectId": { "type": "string", "default": "", "description": "GitLab 项目 ID 或 URL 编码路径（仅 provider=gitlab 时需要）" },
    "title": { "type": "string", "default": "Markdown Preview", "description": "站点标题，用于浏览器标签页和 OGP 元数据（无文档标题时显示）" },
    "defaultTheme": { "type": "string", "default": "default", "description": "默认主题 ID，首次访问（无 localStorage 记录）时生效。可选值：default, iris, github-light, github-dark, notion, arc, dracula, nord, print, blueprint, newsprint, swiss, terminal, neon, sepia, watercolor, graphite, notebook, museum, editorial, aurora, typewriter, blackboard, parcel, aaa" },
    "showEditButton": { "type": "boolean", "default": true, "description": "是否显示「编辑此页」按钮" },
    "showReadingTime": { "type": "boolean", "default": true, "description": "是否显示阅读时间估算" },
    "showBreadcrumbs": { "type": "boolean", "default": true, "description": "是否显示面包屑导航" },
    "homepage": { "type": "string", "default": "", "description": "门户页首页文档路径，如 docs/index.md" },
    "plantumlServers": { "type": "array", "default": "内置列表", "description": "PlantUML 渲染服务列表，按顺序尝试。留空使用内置默认列表" },
    "plugins": { "type": "object", "default": {}, "description": "插件专属配置，按插件名分组传入 init(config)" }
  },

  "features": {
    "color-utils": { "enabled": true, "description": "颜色解析/对比度工具（graph 与 color 插件共用）" },
    "steps": { "enabled": true, "description": "步骤/组织图语法糖（注入 mermaid 块）" },
    "sql-erd": { "enabled": true, "description": "SQL ERD 实体关系图" },
    "mermaid": { "enabled": true, "description": "Mermaid 时序图/流程图/甘特图/ER图/C4/饼图等" },
    "plantuml": { "enabled": true, "description": "PlantUML UML 图表" },
    "kroki": { "enabled": true, "description": "Kroki 图表渲染（PlantUML/Graphviz/Mermaid 等）" },
    "apexcharts": { "enabled": true, "description": "ApexCharts 交互式图表" },
    "vega-lite": { "enabled": true, "description": "Vega-Lite 声明式可视化" },
    "diff": { "enabled": true, "description": "Diff 代码对比渲染" },
    "geo": { "enabled": true, "description": "地理地图渲染（GeoJSON/TopoJSON + Leaflet）" },
    "code-reader": { "enabled": true, "description": "代码阅读器嵌入" },
    "embedded": { "enabled": true, "description": "通用嵌入内容分发器" },
    "github": { "enabled": true, "description": "GitHub 卡片嵌入（Issue/PR/Release）" },
    "katex": { "enabled": true, "description": "KaTeX 数学公式渲染" },
    "pulse": { "enabled": true, "description": "波形动画渲染" },
    "csv-table": { "enabled": true, "description": "CSV 表格渲染" },
    "json-tree": { "enabled": true, "description": "JSON 树形视图" },
    "json-search": { "enabled": true, "description": "JSON 搜索与路径查询" },
    "sandbox": { "enabled": true, "description": "代码沙箱执行" },
    "http-request": { "enabled": true, "description": "HTTP 请求构造器" },
    "openapi": { "enabled": true, "description": "OpenAPI/Swagger 文档渲染" },
    "graph": { "enabled": true, "description": "文档关系图谱" },
    "glossary": { "enabled": true, "description": "术语表渲染" },
    "ipcalc": { "enabled": true, "description": "IP 地址计算器" },
    "config-diff": { "enabled": true, "description": "配置差异对比" },
    "acl": { "enabled": true, "description": "ACL 规则表渲染" },
    "route-table": { "enabled": true, "description": "路由表渲染" },
    "pcap": { "enabled": true, "description": "PCAP 抓包分析" },
    "traceroute": { "enabled": true, "description": "路由追踪可视化" },
    "cli-lab": { "enabled": true, "description": "CLI 实验室" },
    "terminal": { "enabled": true, "description": "终端仿真渲染" },
    "clihelp": { "enabled": true, "description": "CLI 帮助文档渲染" },
    "hotspot": { "enabled": true, "description": "图片热点标注" },
    "log": { "enabled": true, "description": "日志查看器" },
    "har": { "enabled": true, "description": "HAR 文件查看器" },
    "lldp": { "enabled": true, "description": "LLDP 邻居表渲染" },
    "net-tools": { "enabled": true, "description": "Nmap/dig/BGP 网络工具输出渲染" },
    "registry": { "enabled": true, "description": "协议注册表渲染" },
    "trace": { "enabled": true, "description": "网络追踪数据渲染" },
    "table-tools": { "enabled": true, "description": "Markdown 表格交互工具（排序/过滤/导出）" },
    "heatmap": { "enabled": true, "description": "热力图渲染" },
    "bits": { "enabled": true, "description": "位运算可视化" },
    "secret": { "enabled": true, "description": "密钥/敏感信息展示（可折叠）" },
    "pkt-renderer": { "enabled": true, "description": "Packet Tracer 拓扑渲染" },
    "pptx": { "enabled": true, "description": "PPTX 嵌入渲染" },
    "qrcode": { "enabled": true, "description": "二维码生成插件" },
    "countdown": { "enabled": true, "description": "倒计时组件插件" },
    "colorcard": { "enabled": true, "description": "颜色卡片展示插件" },
    "regex": { "enabled": true, "description": "正则表达式测试插件" },
    "cron": { "enabled": true, "description": "Cron 表达式解析插件" },
    "time": { "enabled": true, "description": "时间相关工具插件" },
    "color": { "enabled": true, "description": "颜色工具插件" },
    "hash": { "enabled": true, "description": "哈希计算插件" },
    "jwt": { "enabled": true, "description": "JWT 解析插件" },
    "timeline": { "enabled": true, "description": "时间线组件插件" }
  }
}
