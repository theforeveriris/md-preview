{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "md-preview",
  "version": "0.1.0",
  "identifier": "com.theforeveriris.mdpreview",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "md-preview",
        "width": 1280,
        "height": 860,
        "minWidth": 420,
        "minHeight": 420,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "静态 Markdown 文档站点的桌面端",
    "longDescription": "把 md-preview 静态站点打包为桌面应用：离线可用，外链交给系统浏览器。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/{{EMAIL_5lqkz1}}",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
